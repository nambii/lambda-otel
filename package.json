{
  "name": "lambda-otel",
  "version": "0.2.0",
  "description": "Vendor-neutral OpenTelemetry traces + metrics for AWS Lambda. Exports OTLP; the collector decides the backend.",
  "license": "MIT",
  "author": "Ebin Joshy Nambiaparambil (https://github.com/nambii)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nambii/lambda-otel.git"
  },
  "homepage": "https://github.com/nambii/lambda-otel#readme",
  "bugs": {
    "url": "https://github.com/nambii/lambda-otel/issues"
  },
  "keywords": [
    "opentelemetry",
    "otel",
    "otlp",
    "aws",
    "lambda",
    "serverless",
    "tracing",
    "metrics",
    "observability",
    "telemetry-api"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.mjs",
      "require": "./dist/register.js",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/register.js",
    "./dist/register.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/register.mjs dist/register.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && tsx --test test/*.test.ts",
    "typecheck:examples": "tsc -p tsconfig.examples.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/propagator-aws-xray": "^2.0.0",
    "@opentelemetry/instrumentation-koa": "^0.67.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/propagator-aws-xray": {
      "optional": true
    },
    "@opentelemetry/instrumentation-koa": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/instrumentation-aws-sdk": "^0.74.0",
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0"
  },
  "optionalDependencies": {
    "@opentelemetry/instrumentation-pg": "^0.71.0",
    "@opentelemetry/instrumentation-undici": "^0.29.0"
  },
  "devDependencies": {
    "@koa/router": "^15.6.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-koa": "^0.67.0",
    "@opentelemetry/instrumentation-pino": "^0.65.0",
    "@opentelemetry/instrumentation-winston": "^0.63.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/koa": "^3.0.3",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^20.0.0",
    "koa": "^3.2.1",
    "pino": "^9.14.0",
    "serverless-http": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "@opentelemetry/sdk-trace-base": "$@opentelemetry/sdk-trace-base",
    "@opentelemetry/sdk-metrics": "$@opentelemetry/sdk-metrics",
    "@opentelemetry/resources": "$@opentelemetry/resources",
    "@opentelemetry/api": "$@opentelemetry/api",
    "@opentelemetry/api-logs": "$@opentelemetry/api-logs",
    "@opentelemetry/sdk-logs": "$@opentelemetry/sdk-logs",
    "@opentelemetry/core": "$@opentelemetry/core"
  }
}
